# Credentials & identities — these hold PLAINTEXT account passwords. Never commit.
# (covers bot_identity*.json, *_identity.json, new_identity.json, etc.)
*.json

# Live session output: run logs and filed bug reports.
*.log
*.jsonl

# Local agent / tooling config
.claude/

# The Hollow Grid and Discord bots' manifests are real (non-secret) package files,
# not identity files; keep them tracked despite the blanket *.json ignore above.
!hollow-grid/package.json
!discord/package.json
!discord/package-lock.json

# discord.js dependencies -- never commit
discord/node_modules/
