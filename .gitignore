# Credentials & identities — these hold PLAINTEXT account passwords. Never commit.
# (covers bot_identity*.json, *_identity.json, new_identity.json, etc.)
*.json

# Live session output: run logs and filed bug reports.
*.log
*.jsonl

# Local agent / tooling config
.claude/

# Laptop compose run output (logs/jsonl stay untracked; keep the dir)
hollow-grid/local/logs/*
!hollow-grid/local/logs/.gitkeep

# The Hollow Grid bot's manifest is a real (non-secret) package file, not an
# identity file; keep it tracked despite the blanket *.json ignore above.
!hollow-grid/package.json
